rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // التحقق من أن المستخدم مسجل دخول بحساب جوجل موثق
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // القائمة الحديدية للإدارة العليا الثلاثة (لا يمكن لأحد غيرهم إدارة الموظفين)
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email.lower() in [
        'rawialshamal@gmail.com',
        'a1hmedrashad@gmail.com',
        'safaqatkitabiya@gmail.com'
      ];
    }

    // 1. مجموعة الموظفين (staff):
    // القراءة متاحة للتحقق عند الدخول، لكن الإضافة أو الحذف مقفلة حصرياً للإدارة العليا الثلاثة
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // 2. مجموعة الكُتّاب (authors):
    match /authors/{authorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 3. مجموعة الكتب (books):
    match /books/{bookId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // 4. السجل المالي للمبيعات والمصاريف والتقارير:
    match /sales/{saleId} {
      allow read, write: if isSignedIn();
    }

    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    match /mail_reports/{reportId} {
      allow read, write: if isSignedIn();
    }
  }
}
